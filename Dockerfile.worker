# Cloud Run webhook worker. Build from the repo root:
#   docker build -f Dockerfile.worker -t shopify-webhooks .
FROM node:22-alpine
RUN apk add --no-cache openssl

WORKDIR /app

ENV PORT=8080

COPY package.json yarn.lock ./
COPY prisma ./prisma
COPY prisma.config.ts ./
COPY tsconfig.json ./

RUN corepack enable \
  && yarn install --frozen-lockfile \
  && DIRECT_URL="postgresql://127.0.0.1:5432/postgres" yarn prisma generate

COPY app ./app
COPY webhooks ./webhooks
COPY certs ./certs

ENV NODE_ENV=production

EXPOSE 8080

CMD ["yarn", "worker"]
