# Cloud Run webhook worker. Build from the repo root:
#   docker build -f Dockerfile.worker -t shopify-webhooks .
FROM node:22-alpine
RUN apk add --no-cache openssl

WORKDIR /app

ENV PORT=8080
ENV HUSKY=0
ENV NODE_ENV=production

COPY package.json yarn.lock ./
COPY prisma ./prisma
COPY prisma.config.ts ./
COPY tsconfig.json ./

RUN corepack enable \
  && yarn install --frozen-lockfile --ignore-scripts \
  && DIRECT_URL="postgresql://127.0.0.1:5432/postgres" yarn prisma generate

COPY app ./app
COPY webhooks ./webhooks
COPY certs ./certs

RUN yarn worker:build

EXPOSE 8080

CMD ["node", "dist/worker.js"]
