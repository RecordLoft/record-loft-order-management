// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Order {
  id           BigInt    @id // Raw Shopify ID (e.g., 123456789)
  orderNumber  Int       @unique
  shop         String
  totalPrice   Decimal   @db.Decimal(10, 2)
  currency     String
  createdAt    DateTime  @default(now())
  
  // Relationships
  customer     Customer? @relation(fields: [customerId], references: [id])
  customerId   BigInt?   // Must match Customer.id type
  lineItems    LineItem[]
}

model LineItem {
  id        BigInt  @id
  orderId   BigInt  // Must match Order.id type
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  title     String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  variantId BigInt? // Raw variant ID
  sku       String?
  properties Json?
  productType   String?
  category String?
  storeSection  String?
}

model Customer {
  id        BigInt  @id
  email     String?
  firstName String?
  lastName  String?
  orders    Order[]
}