// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Order {
  id           BigInt    @id // Raw Shopify ID (e.g., 123456789)
  orderNumber  Int       @unique
  shop         String
  totalPrice   Decimal   @db.Decimal(10, 2)
  currency     String
  createdAt    DateTime  @default(now())
  
  // Relationships
  customer     Customer? @relation(fields: [customerId], references: [id])
  customerId   BigInt?   // Must match Customer.id type
  lineItems    LineItem[]
  deliveryMethod String?
  ospStatusName     String?
  ospStatusSyncedAt DateTime?

  @@index([shop, deliveryMethod])
}

model LineItem {
  id        BigInt  @id
  orderId   BigInt  // Must match Order.id type
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  title     String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  variantId BigInt? // Raw variant ID
  sku       String?
  properties Json?
  productType   String?
  category String?
  storeSection  String?
}

model Customer {
  id        BigInt  @id
  email     String?
  phone     String?
  firstName String?
  lastName  String?
  orders    Order[]
}

enum WebhookFailureStatus {
  pending
  processing
  failed
}

enum WebhookFailureHandler {
  product_description_sync
  orders_create
  ack_drop
}

/// Queued and failed webhook work — successes are deleted after processing.
model WebhookFailure {
  id              String                @id @default(cuid())
  shop            String
  handler         WebhookFailureHandler
  topic           String
  resourceId      BigInt
  resourceGid     String?
  webhookId       String?
  payload         Json
  status          WebhookFailureStatus  @default(pending)
  outcome         String?
  errorCode       String?
  errorMessage    String?               @db.Text
  attempts        Int                   @default(0)
  maxAttempts     Int                   @default(5)
  lastAttemptAt   DateTime?
  completedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([shop, handler, resourceId])
  @@index([status, createdAt])
  @@index([shop, handler, status])
}
